FROM node:22-alpine
WORKDIR /app

# Ставим зависимости отдельным слоем — переустановка идёт только при изменении package*.json
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# --host 0.0.0.0 обязателен, иначе dev-сервер слушает только localhost внутри контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
